{
  "name": "promiseledger-frontend",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc -b && vite build",
    "size": "node scripts-size.mjs",
    "build:report": "npm run build && node scripts-size.mjs",
    "preview": "vite preview",
    "test:contract": "pytest -q",
    "test:all": "npm test && pytest -q",
    "mutation": "python scripts/mutation_check.py",
    "deploy": "node e2e/deploy.mjs",
    "e2e": "node e2e/live-e2e.mjs",
    "e2e:quick": "node e2e/live-e2e.mjs --quick"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "5.1.1",
    "@fontsource/ibm-plex-mono": "5.1.1",
    "@fontsource/ibm-plex-sans": "5.1.1",
    "@react-three/fiber": "8.17.10",
    "genlayer-js": "1.2.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.6",
    "three": "0.169.0"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "14.5.2",
    "@types/node": "22.10.2",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/three": "0.169.0",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "9.17.0",
    "eslint-plugin-react-hooks": "5.1.0",
    "globals": "15.14.0",
    "jsdom": "25.0.1",
    "typescript": "5.7.3",
    "typescript-eslint": "8.18.2",
    "viem": "2.56.3",
    "vite": "5.4.21",
    "vitest": "2.1.8"
  }
}
